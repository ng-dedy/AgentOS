# AgentOS production configuration template (milestone 2C). Values in <> are placeholders.
# Secrets (marked SECRET) come from the secret manager, never from this file or the image.
# The API and the worker refuse to start if a required rule fails (docs/deployment-runbook.md §2).

AGENTOS_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# ---- Database (session-mode connection: the event listener uses LISTEN) ----
DATABASE_URL=postgresql://agentos_app:<SECRET>@<db-host>:5432/agentos?sslmode=verify-full

# ---- Execution: Temporal is required ----
AGENTOS_WORKFLOW_ENGINE=temporal
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_TASK_QUEUE=agentos-tasks
TEMPORAL_TLS=true
# Either an API key (SECRET) ...
TEMPORAL_API_KEY=<SECRET>
# ... or mTLS client certificate files mounted from the secret manager:
# TEMPORAL_TLS_CERT_PATH=/run/secrets/temporal/client.pem
# TEMPORAL_TLS_KEY_PATH=/run/secrets/temporal/client.key
# TEMPORAL_TLS_CA_PATH=/run/secrets/temporal/ca.pem        # only for a private CA
# TEMPORAL_TLS_SERVER_NAME=<sni-name>                       # only if it differs from the address host
TEMPORAL_CONNECT_ATTEMPTS=5
TEMPORAL_CONNECT_TIMEOUT_MS=10000
AGENTOS_ACTIVITY_HEARTBEAT_TIMEOUT_MS=30000
AGENTOS_STEP_TIMEOUT_MS=900000
AGENTOS_STEP_MAX_ATTEMPTS=5
AGENTOS_WORKFLOW_RUN_TIMEOUT_MS=0

# ---- Key management: AWS KMS is required (no development keys may be present) ----
AGENTOS_KMS_PROVIDER=aws
AGENTOS_AWS_KMS_KEY_ID=arn:aws:kms:<region>:<account>:key/<key-id>
AWS_REGION=<region>
# During a KMS key change only:
# AGENTOS_AWS_KMS_PREVIOUS_KEY_IDS=arn:aws:kms:<region>:<account>:key/<old-key-id>
# Credentials come from the IAM role (IRSA / ECS task role / instance profile). No static keys.
AGENTOS_CREDENTIAL_CACHE_TTL_MS=60000

# ---- Providers ----
AGENTOS_ENABLE_MOCK_PROVIDER=false
AGENTOS_ALLOW_DEPLOYMENT_KEYS=false
AGENTOS_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENTOS_XAI_BASE_URL=https://api.x.ai/v1
PROVIDER_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=2
AGENTOS_UNPRICED_CALL_RESERVE_USD=0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=https://<app-domain>
SESSION_COOKIE_SECURE=true
AGENTOS_METRICS_TOKEN=<SECRET, 32+ chars>
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_FORCE_MS=30000
EVENT_RECONCILE_MS=2000

# ---- Worker ----
WORKER_HEALTH_PORT=9464
WORKER_HEALTH_HOST=0.0.0.0
WORKER_MAX_CONCURRENT_ACTIVITIES=20
WORKER_SHUTDOWN_GRACE_MS=30000
WORKER_SHUTDOWN_FORCE_MS=60000
TEMPORAL_WORKFLOW_BUNDLE_PATH=/app/packages/workflows/dist/workflow-bundle.js
TEMPORAL_WORKER_BUILD_ID=<git-commit>
# Worker deployment versioning (recommended for workflow code changes; docs/deployment-runbook.md §7)
TEMPORAL_WORKER_VERSIONING=false
TEMPORAL_WORKER_DEPLOYMENT_NAME=agentos-worker
TEMPORAL_WORKER_DEFAULT_VERSIONING=PINNED
