    "@agentos/workflows": "workspace:*",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0"
  }
}
