# Copy to .env. Never commit real keys.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos_test
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false

# Provider keys (server-side only). Leave blank and the provider shows "Not configured".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Provider endpoints. Always explicit: the SDKs' own OPENAI_BASE_URL / ANTHROPIC_BASE_URL
# variables are ignored so a host environment cannot redirect your keys. https only.
AGENTOS_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENTOS_XAI_BASE_URL=https://api.x.ai/v1
# Per model call timeout and retry budget for retryable provider errors.
PROVIDER_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=2
# Behind an HTTP(S) proxy, Node's fetch needs this to honour HTTPS_PROXY (Node >= 22.21).
# NODE_USE_ENV_PROXY=1

# Scripted mock provider for tests and local demos. Clearly labelled as MOCK in the UI.
AGENTOS_ENABLE_MOCK_PROVIDER=true
# Optional JSON override of the model catalog (see packages/providers/src/catalog.ts)
AGENTOS_MODEL_CATALOG_JSON=
