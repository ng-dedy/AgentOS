# Copy to .env. Never commit real keys.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos_test
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false

# ---- Durable execution (milestone 2B) ----
# temporal: tasks run as Temporal workflows on worker processes (pnpm --filter @agentos/worker start)
# inprocess: tasks run inside the API process (not durable; unit tests / quick demos)
AGENTOS_WORKFLOW_ENGINE=temporal
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentos-tasks
# How quickly a dead worker's step moves to another worker.
AGENTOS_ACTIVITY_HEARTBEAT_TIMEOUT_MS=30000

# ---- Organization provider credentials (milestone 2B) ----
# Each workspace adds its own keys in Settings; they are envelope-encrypted at rest.
# DEVELOPMENT ONLY key-encryption keys: id:base64(32 bytes), comma-separated, last one active.
# Generate one with: openssl rand -base64 32
# Refused when NODE_ENV=production. Use a managed KMS in production (docs/credentials.md).
AGENTOS_DEV_KMS_KEYS=
# Let workspaces without their own key use the deployment keys below. Off by default.
AGENTOS_ALLOW_DEPLOYMENT_KEYS=false
# Deployment-wide provider keys (server-side only). Used only when the flag above is true,
# and by the live test suites.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Provider endpoints. Always explicit: the SDKs' own OPENAI_BASE_URL / ANTHROPIC_BASE_URL
# variables are ignored so a host environment cannot redirect your keys. https only.
AGENTOS_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENTOS_XAI_BASE_URL=https://api.x.ai/v1
# Per model call timeout and retry budget for retryable provider errors.
PROVIDER_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=2
# Behind an HTTP(S) proxy, Node's fetch needs this to honour HTTPS_PROXY (Node >= 22.21).
# NODE_USE_ENV_PROXY=1

# Scripted mock provider for tests and local demos. Clearly labelled as MOCK in the UI.
AGENTOS_ENABLE_MOCK_PROVIDER=true
# Optional JSON override of the model catalog (see packages/providers/src/catalog.ts)
AGENTOS_MODEL_CATALOG_JSON=
