// AgentOS data model, milestone 1.
// Every organization-owned table carries organizationId and is indexed by it.
// IDs are cuid-like strings generated by Prisma; timestamps are UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  defaultProvider String?
  defaultModel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   Membership[]
  agents        Agent[]
  conversations Conversation[]
  tasks         Task[]
  runs          AgentRun[]
  events        RunEvent[]
  toolCalls     ToolCall[]
  approvals     Approval[]
  skills        Skill[]
  artifacts     Artifact[]
  usage         UsageRecord[]
  auditLogs     AuditLog[]
  idempotency   IdempotencyKey[]
  credentials   ProviderCredential[]
  modelCalls    ModelCallAttempt[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member") // owner | member
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Agent {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  role           String
  instructions   String
  provider       String
  model          String
  allowedTools   String[]
  maxIterations  Int      @default(8)
  maxRunCostUsd  Decimal  @default(1) @db.Decimal(12, 6)
  maxRunTokens   Int?
  status         String   @default("active")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills        SkillAssignment[]
  conversations Conversation[]
  tasks         Task[]
  runs          AgentRun[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Skill {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        Int
  description    String
  instructions   String
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  SkillAssignment[]

  @@unique([organizationId, name, version])
}

model SkillAssignment {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages     Message[]
  tasks        Task[]

  @@index([organizationId, agentId])
}

/// Conversation transcript. role: user | assistant | tool.
/// For assistant turns `toolCalls` holds normalized tool calls and `providerState`
/// holds the provider's raw content needed to replay the turn (e.g. thinking blocks).
model Message {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  runId          String?
  role           String
  content        String
  toolCalls      Json?
  toolCallId     String?
  toolName       String?
  isError        Boolean  @default(false)
  providerState  Json?
  createdAt      DateTime @default(now())
  seq            BigInt   @default(autoincrement())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  @@index([conversationId, runId])
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String
  kind              String // single | pipeline | pipeline_step | chat
  title             String
  instruction       String
  status            String    @default("queued")
  agentId           String?
  conversationId    String?
  parentTaskId      String?
  stepIndex         Int?
  pipelineSpec      Json?
  handoffInput      Json?
  result            String?
  resultData        Json?
  failureCode       String?
  failureMessage    String?
  retryOfId         String?
  cancelRequestedAt DateTime?
  /// Durable execution id (Temporal workflow id) once the task has been started.
  workflowId        String?
  /// Spending limit for the whole task tree, in USD. Null = only the agent's per-run budget applies.
  maxCostUsd        Decimal?  @db.Decimal(12, 6)
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Task?         @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children     Task[]        @relation("TaskChildren")
  runs         AgentRun[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([parentTaskId])
}

model AgentRun {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  agentId        String
  provider       String
  model          String
  status         String    @default("running")
  iterations     Int       @default(0)
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Decimal   @default(0) @db.Decimal(12, 6)
  failureCode    String?
  failureMessage String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]
  usage        UsageRecord[]

  @@index([organizationId, status])
  @@index([taskId])
}

/// Append-only event log. `seq` is global and monotonic, used as the SSE event id.
model RunEvent {
  seq            BigInt   @id @default(autoincrement())
  organizationId String
  taskId         String
  rootTaskId     String
  runId          String?
  agentId        String?
  type           String
  payload        Json
  createdAt      DateTime @default(now())
  /// Id of the inserting transaction (pg_current_xact_id()). Commit-safe event cursor; see packages/platform/src/events/cursor.ts.
  /// Null only for rows written before milestone 2C, which are all older than any watermark.
  txid           Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([rootTaskId, seq])
  @@index([organizationId, seq])
  @@index([txid])
}

/// One provider request, reserved before it is sent and settled after (milestone 2C).
/// The ledger makes spending limits hold before a call and shows calls that may have been
/// billed without a stored result (worker crash between the reply and persisting it).
model ModelCallAttempt {
  id              String    @id @default(cuid())
  organizationId  String
  rootTaskId      String
  taskId          String
  runId           String
  /// Model turn within the run (0-based) and the request number for that turn (1, 2, ...).
  turn            Int
  sequence        Int
  /// Temporal activity attempt that made the request (1 = first); null in-process.
  activityAttempt Int?
  provider        String
  model           String
  /// reserved -> succeeded | failed; reserved rows found by a later attempt become orphaned.
  status          String
  /// Conservative maximum cost held against the limits while the request is open.
  reservedUsd     Decimal   @db.Decimal(12, 6)
  /// Estimated cost from reported usage (catalog prices); null until it succeeds.
  actualUsd       Decimal?  @db.Decimal(12, 6)
  inputTokens     Int?
  outputTokens    Int?
  /// The successful reply was stored and its usage recorded on the run.
  recorded        Boolean   @default(false)
  /// The request failed in a way the provider may still have charged for (timeout, dropped connection).
  billingUnknown  Boolean   @default(false)
  /// An earlier request for the same turn may have been billed without its result being kept.
  possibleDuplicate Boolean @default(false)
  error           String?
  createdAt       DateTime  @default(now())
  settledAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([runId, turn, sequence])
  @@index([rootTaskId, status])
  @@index([organizationId, createdAt])
}

model ToolCall {
  id             String    @id @default(cuid())
  organizationId String
  runId          String
  taskId         String
  providerCallId String
  toolName       String
  arguments      Json
  status         String
  risk           String?
  output         Json?
  error          String?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval     Approval?

  /// Idempotency: a provider tool call is executed at most once per run.
  @@unique([runId, providerCallId])
  @@index([organizationId, createdAt])
}

model Approval {
  id             String    @id @default(cuid())
  organizationId String
  toolCallId     String    @unique
  taskId         String
  runId          String
  agentId        String
  toolName       String
  arguments      Json
  reason         String
  status         String    @default("pending")
  decidedById    String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolCall     ToolCall     @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Artifact {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  runId          String?
  name           String
  mimeType       String
  content        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  runId          String
  agentId        String
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  cachedTokens   Int      @default(0)
  costUsd        Decimal  @db.Decimal(12, 6)
  /// Wall-clock latency of the successful model call, in ms.
  latencyMs      Int?
  /// Activity attempt that produced this call (1 = first). >1 means a retry after a failure.
  attempt        Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String // user | system
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  route          String
  requestHash    String
  statusCode     Int
  response       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, route, key])
}

/// An organization's own provider API key, envelope-encrypted.
/// `ciphertext` is AES-256-GCM under a random per-credential data key; `wrappedKey` is that
/// data key encrypted by the key-management service under key `kekId`. The AAD binds the
/// ciphertext to (organizationId, provider, id), so a row copied to another org will not decrypt.
model ProviderCredential {
  id               String    @id @default(cuid())
  organizationId   String
  provider         String
  ciphertext       Bytes
  iv               Bytes
  authTag          Bytes
  wrappedKey       Bytes
  kekId            String
  /// Last four characters only, for display.
  keyHint          String
  /// unverified | valid | invalid
  status           String    @default("unverified")
  lastVerifiedAt   DateTime?
  lastVerifyError  String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  rotatedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([kekId])
}

/// Liveness of worker processes. Written by each worker every few seconds.
model WorkerHeartbeat {
  id               String   @id
  hostname         String
  pid              Int
  taskQueue        String
  version          String
  activeActivities Int      @default(0)
  status           String   @default("running") // running | stopping
  startedAt        DateTime
  lastSeenAt       DateTime

  @@index([lastSeenAt])
}
