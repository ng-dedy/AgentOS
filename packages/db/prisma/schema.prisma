// AgentOS data model, milestone 1.
// Every organization-owned table carries organizationId and is indexed by it.
// IDs are cuid-like strings generated by Prisma; timestamps are UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  defaultProvider String?
  defaultModel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   Membership[]
  agents        Agent[]
  conversations Conversation[]
  tasks         Task[]
  runs          AgentRun[]
  events        RunEvent[]
  toolCalls     ToolCall[]
  approvals     Approval[]
  skills        Skill[]
  artifacts     Artifact[]
  usage         UsageRecord[]
  auditLogs     AuditLog[]
  idempotency   IdempotencyKey[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member") // owner | member
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Agent {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  role           String
  instructions   String
  provider       String
  model          String
  allowedTools   String[]
  maxIterations  Int      @default(8)
  maxRunCostUsd  Decimal  @default(1) @db.Decimal(12, 6)
  maxRunTokens   Int?
  status         String   @default("active")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills        SkillAssignment[]
  conversations Conversation[]
  tasks         Task[]
  runs          AgentRun[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Skill {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        Int
  description    String
  instructions   String
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  SkillAssignment[]

  @@unique([organizationId, name, version])
}

model SkillAssignment {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages     Message[]
  tasks        Task[]

  @@index([organizationId, agentId])
}

/// Conversation transcript. role: user | assistant | tool.
/// For assistant turns `toolCalls` holds normalized tool calls and `providerState`
/// holds the provider's raw content needed to replay the turn (e.g. thinking blocks).
model Message {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  runId          String?
  role           String
  content        String
  toolCalls      Json?
  toolCallId     String?
  toolName       String?
  isError        Boolean  @default(false)
  providerState  Json?
  createdAt      DateTime @default(now())
  seq            BigInt   @default(autoincrement())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String
  kind              String // single | pipeline | pipeline_step | chat
  title             String
  instruction       String
  status            String    @default("queued")
  agentId           String?
  conversationId    String?
  parentTaskId      String?
  stepIndex         Int?
  pipelineSpec      Json?
  handoffInput      Json?
  result            String?
  resultData        Json?
  failureCode       String?
  failureMessage    String?
  retryOfId         String?
  cancelRequestedAt DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Task?         @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children     Task[]        @relation("TaskChildren")
  runs         AgentRun[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([parentTaskId])
}

model AgentRun {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  agentId        String
  provider       String
  model          String
  status         String    @default("running")
  iterations     Int       @default(0)
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Decimal   @default(0) @db.Decimal(12, 6)
  failureCode    String?
  failureMessage String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]
  usage        UsageRecord[]

  @@index([organizationId, status])
  @@index([taskId])
}

/// Append-only event log. `seq` is global and monotonic, used as the SSE event id.
model RunEvent {
  seq            BigInt   @id @default(autoincrement())
  organizationId String
  taskId         String
  rootTaskId     String
  runId          String?
  agentId        String?
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([rootTaskId, seq])
  @@index([organizationId, seq])
}

model ToolCall {
  id             String    @id @default(cuid())
  organizationId String
  runId          String
  taskId         String
  providerCallId String
  toolName       String
  arguments      Json
  status         String
  risk           String?
  output         Json?
  error          String?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval     Approval?

  /// Idempotency: a provider tool call is executed at most once per run.
  @@unique([runId, providerCallId])
  @@index([organizationId, createdAt])
}

model Approval {
  id             String    @id @default(cuid())
  organizationId String
  toolCallId     String    @unique
  taskId         String
  runId          String
  agentId        String
  toolName       String
  arguments      Json
  reason         String
  status         String    @default("pending")
  decidedById    String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolCall     ToolCall     @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Artifact {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  runId          String?
  name           String
  mimeType       String
  content        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  runId          String
  agentId        String
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  cachedTokens   Int      @default(0)
  costUsd        Decimal  @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String // user | system
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  route          String
  requestHash    String
  statusCode     Int
  response       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, route, key])
}
